# Copy to .env - docker compose reads it. One COMPARE_CONN_<NAME>=<uri> per line; the
# connection appears in the app as <NAME>. Airflow-style URIs; see README for every kind.
# COMPARE_CONN_PROD=snowflake://USER:PASSWORD@ACCOUNT/DB/SCHEMA?warehouse=WH&role=ROLE
# COMPARE_CONN_SAMPLE=duckdb:////data/sample.duckdb
